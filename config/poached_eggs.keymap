#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        lang2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <16 15>;
        };

        blue {
            bindings = <&lt 4 ESCAPE>;
            key-positions = <37 38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans             &kp Q             &kp W         &kp E         &kp R     &kp T                                            &kp RG(RBKT)  &kp RG(LBKT)  &trans     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&kp K_SCROLL_UP    &kp A             &kp S         &kp D         &lt 3 F   &kp G                                            &kp Y         &kp U         &kp I      &kp O              &kp P            &trans
&kp K_SCROLL_DOWN  &kp Z             &kp X         &kp C         &kp V     &kp B                                            &kp H         &kp J         &lt 3 K    &lt 1 L            &kp MINUS        &trans
&trans             &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_WIN  &mkp MB1  &lt 2 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &kp DEL  &kp N         &kp M         &kp COMMA  &kp DOT            &kp FSLH         &studio_unlock
            >;
        };

        layer1 {
            bindings = <
&trans  &trans  &trans  &trans                 &msc SCRL_UP    &trans                                &trans     &trans              &trans               &trans  &trans                    &trans
&trans  &trans  &trans  &msc SCRL_LEFT         &msc SCRL_DOWN  &msc SCRL_RIGHT                       &trans     &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &trans  &trans                    &trans
&trans  &trans  &trans  &kp LG(RIGHT_BRACKET)  &trans          &kp LG(LEFT_BRACKET)                  &kp RG(R)  &mkp MB1            &mkp MB2             &trans  &kp RG(W)                 &trans
&trans  &trans  &trans  &trans                 &trans          &trans                &trans  &trans  &kp RG(C)  &kp RG(V)           &trans               &trans  &kp RS(RC(RG(NUMBER_4)))  &trans
            >;
        };

        layer2 {
            bindings = <
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4          &kp N5                               &none         &none           &none             &none             &none              &none
&none  &kp EXCL      &kp AT        &kp HASH       &kp LEFT_BRACKET      &kp RIGHT_BRACKET                    &kp NUMBER_6  &kp N7          &kp N8            &kp N9            &kp N0             &none
&none  &kp DOLLAR    &kp PERCENT   &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                &none         &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp SEMICOLON     &kp COLON          &none
&none  &none         &none         &none          &none                 &none                  &none  &none  &none         &kp LESS_THAN   &kp GREATER_THAN  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &none
            >;
        };

        layer3 {
            bindings = <
&none  &kp BACKSPACE  &kp KP_N7  &kp KP_N8  &kp KP_N9        &kp KP_DOT                         &none    &none           &none           &none            &none  &none
&none  &kp INT_YEN    &kp KP_N4  &kp KP_N5  &kp KP_N6        &kp KP_PLUS                        &none    &none           &kp UP_ARROW    &none            &none  &none
&none  &kp KP_N0      &kp KP_N1  &kp KP_N2  &kp KP_N3        &kp KP_MINUS                       &kp F7   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &none
&none  &none          &none      &none      &kp KP_MULTIPLY  &kp KP_SLASH  &kp KP_EQUAL  &none  &kp F10  &none           &none           &none            &none  &none
            >;
        };

        layer4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
