#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        lang2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <16 15>;
        };

        blue {
            bindings = <&lt 4 ESCAPE>;
            key-positions = <37 38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans  &kp Q             &kp W         &kp E         &kp R     &kp T                                           &kp RG(RBKT)  &kp RG(LBKT)  &trans     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&trans  &kp A             &kp S         &kp D         &lt 3 F   &kp G                                           &kp Y         &kp U         &kp I      &kp O              &kp P            &trans
&trans  &kp Z             &kp X         &kp C         &kp V     &kp B                                           &kp H         &kp J         &lt 3 K    &lt 1 L            &kp MINUS        &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &mkp MB1  &lt 2 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &kp F7  &kp N         &kp M         &kp COMMA  &kp DOT            &kp FSLH         &studio_unlock
            >;
        };

        layer1 {
            bindings = <
&trans  &trans  &trans  &trans          &msc SCRL_UP    &trans                           &trans     &trans              &trans               &trans  &trans                    &trans
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                  &trans     &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &trans  &trans                    &trans
&trans  &trans  &trans  &trans          &trans          &trans                           &kp RG(R)  &mkp MB1            &mkp MB2             &trans  &kp RG(W)                 &trans
&trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans  &kp RG(C)  &kp RG(V)           &trans               &trans  &kp RS(RC(RG(NUMBER_4)))  &trans
            >;
        };

        layer2 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                   &kp F7    &kp F8     &kp F9     &kp F10   &kp F11    &kp F12
&none   &none   &none   &none   &none   &none                    &none     &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none
&none   &none   &none   &none   &none   &none                    &kp PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
&none   &none   &none   &trans  &trans  &mo 3   &trans  &kp DEL  &trans    &trans     &trans     &none     &none      &none
            >;
        };

        layer3 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &none  &none  &none  &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none                       &none  &none  &none  &none  &none  &none
&none           &none         &none         &none         &none         &none                       &none  &none  &none  &none  &none  &none
&kp O           &kp M         &kp U         &none         &none         &none         &none  &none  &none  &none  &none  &kp K  &kp E  &kp N
            >;
        };

        layer4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
